; Engine configuration file.
; Mesh Volume Clouds — portable Godot 4.7 project for mobile/VR-friendly mesh clouds.

config_version=5

[application]

config/name="Mesh Volume Clouds"
run/main_scene="res://demo/mesh_clouds_demo.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=0
environment/defaults/default_clear_color=Color(0.4, 0.55, 0.75, 1)
